# Copy this file to .env and fill in real values before deploying.

# Port the server listens on
PORT=3000

# Secret used to sign admin login tokens — set a long random string in production
JWT_SECRET=change-this-secret-in-production

# Used only by `npm run seed` to create the first admin account
SEED_ADMIN_USER=admin
SEED_ADMIN_PASS=museum-admin-2026

# Museum chatbot — get a key at https://openrouter.ai/keys
# Leave blank to disable the chat widget's backend (it will show a friendly
# "not configured" message instead of erroring).
# OpenRouter API Key for Chat Assistant
OPENROUTER_API_KEY=your_openrouter_api_key

# MongoDB Connection String (Required for Database)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/museum?retryWrites=true&w=majority

# Cloudinary Configuration (Required for Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
OPENROUTER_MODEL=openai/gpt-4o
# Shown to OpenRouter to identify your app — set these to your real site once deployed.
SITE_URL=http://localhost:3000
SITE_NAME=Museo Sang Bata sa Negros
