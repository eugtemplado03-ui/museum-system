# Copy this file to .env and fill in real values before deploying.

# Port the server listens on
PORT=3000

# Secret used to sign admin login tokens — set a long random string in production
JWT_SECRET=change-this-secret-in-production

# Used only by `npm run seed` to create the first admin account
SEED_ADMIN_USER=admin
SEED_ADMIN_PASS=museum-admin-2026

# Optional Groq key for chatbot, translation, and text-to-speech.
# Optional Cloudinary credentials for remote uploads and data backup.
# These providers can also be managed in Admin Dashboard > API Management.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional Fish Audio TTS for Tagalog, Cebuano/Bisaya, and Hiligaynon narration.
# Set a voice model ID for each language; use only voices that support that language.
FISH_AUDIO_API_KEY=
FISH_AUDIO_MODEL=s2.1-pro-free
FISH_AUDIO_VOICE_ID_TL=
FISH_AUDIO_VOICE_ID_CEB=
FISH_AUDIO_VOICE_ID_HIL=

# MongoDB Connection String (Required for Database)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/museum?retryWrites=true&w=majority

# Cloudinary Configuration (Required for Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
